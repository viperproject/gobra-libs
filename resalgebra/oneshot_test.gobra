// +gobra

package resalgebra

import "sync"

type oneshot struct {
	V int
	isInit bool
	ghost e Elem
	// The share of the ghost location owned by the lock invariant. Splitting and
	// merging changes the share, but never its location name, so the invariant
	// stores the share in a ghost field and is parameterized by the (stable)
	// location name.
	ghost u UniqueLoc
}

pred oneshotInv(o *oneshot, l LocName) {
	acc(o) &&
	o.u.GetLocName() == l &&
	GhostLocation(o.u, OneShotRA, o.e) &&
	(!o.isInit ==> o.e == Pending{} && o.V == 0) &&
	(o.isInit ==> o.e == Shot{o.V})
}

ensures oneshotInv(o, l)
decreases
func mkOneShot() (o *oneshot, ghost l LocName) {
	o = new(oneshot)
	o.u = Alloc(OneShotRA, Pending{})
	l = o.u.GetLocName()
	o.e = Pending{}
	fold oneshotInv(o, l)
	return o, l
}

requires m.LockP()
requires m.LockInv() == oneshotInv{o, l}
requires n != 0
func (o *oneshot) trySet(n int, m *sync.Mutex, ghost l LocName) bool {
	m.Lock()
	defer m.Unlock()
	unfold oneshotInv{o, l}()
	defer fold oneshotInv{o, l}()
	if o.isInit {
		return false
	}
	// A frame-preserving update leaves the share (and hence o.u) unchanged.
	GhostUpdate(o.u, OneShotRA, Pending{}, Shot{n})
	o.V = n
	o.isInit = true
	ghost o.e = Shot{n}
	return true
}

requires m.LockP()
requires m.LockInv() == oneshotInv{o, l}
func (o *oneshot) check(m *sync.Mutex, ghost l LocName) {
	m.Lock()
	unfold oneshotInv{o, l}()
	y1 := o.V
	ghost e1 := o.e
	ghost isInit1 := o.isInit
	// The share of Shot{y1} that we take out of the lock invariant, if any.
	ghost var u1 UniqueLoc
	ghost if isInit1 {
		assert e1 == Shot{y1}
		assert OneShotRA.Compose(e1, e1) == e1
		assert GhostLocation(o.u, OneShotRA, e1)
		o.u, u1 = GhostOp1(o.u, OneShotRA, e1, e1)
		assert GhostLocation(o.u, OneShotRA, e1) && GhostLocation(u1, OneShotRA, e1)
		assert u1.GetLocName() == l
	}
	fold oneshotInv{o, l}()
	m.Unlock()

	m.Lock()
	unfold oneshotInv{o, l}()
	y2 := o.V
	ghost e2 := o.e
	ghost isInit2 := o.isInit
	ghost if isInit1 && !isInit2 {
		assert GhostLocation(u1, OneShotRA, Shot{y1})
		assert GhostLocation(o.u, OneShotRA, Pending{})
		GhostOp2(u1, o.u, OneShotRA, Shot{y1}, Pending{})
		GhostValid(u1, OneShotRA, OneShotRA.Compose(Shot{y1}, Pending{}))
		assert false // Unreachable
	}
	ghost if isInit1 && isInit2 {
		assert GhostLocation(u1, OneShotRA, e1) && GhostLocation(o.u, OneShotRA, e2)
		GhostValid(u1, OneShotRA, e1)
		GhostValid(o.u, OneShotRA, e2)
		GhostOp2(u1, o.u, OneShotRA, e1, e2)
		GhostValid(u1, OneShotRA, OneShotRA.Compose(e1, e2))
		assert e1 == e2
		// The merged share replaces the one owned by the lock invariant; it has
		// the same location name and holds `Compose(e1, e2) == e2 == o.e`.
		o.u = u1
	}
	fold oneshotInv{o, l}()
	m.Unlock()
}
