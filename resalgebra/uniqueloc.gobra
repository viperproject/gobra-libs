// +gobra

package resalgebra

// All lemmas for ghost locations in `loc.gobra` are formulated in terms of an
// explicit `Witness` value, because Gobra cannot existentially quantify over
// resources. Instead of axiomatizing the introduction and elimination rules for
// that existential, this file packages the location name and its witness into a
// single opaque value of type `UniqueLoc`. Clients never see the witness (both
// fields are unexported), so the public API in `loc.gobra` stays as convenient
// as a witness-free one, and no part of it has to be assumed.

// UniqueLoc identifies one particular share of the resource stored at a ghost
// location. Both of its fields are unexported: clients obtain a `UniqueLoc`
// from `Alloc` and thread it through the operations of `loc.gobra`. Two shares
// of the same ghost location have the same location name (see `GetLocName`) but
// different witnesses.
ghost type UniqueLoc ghost struct {
	// the name of the ghost location
	l LocName
	// the witness identifying this share of the resource at l
	w Witness
}

// GetLocName returns the name of the ghost location that u refers to. This is
// the stable identity of the location: it is preserved by every operation and
// shared by all `UniqueLoc`s that refer to the same location.
ghost
decreases
pure func (u UniqueLoc) GetLocName() LocName {
	return u.l
}

// GhostLocation(u, ra, e) states ownership of the element e of the resource
// algebra ra at the ghost location u.
pred GhostLocation(u UniqueLoc, ra RA, e Elem) {
	GhostLocationW(u.l, ra, e, u.w)
}
